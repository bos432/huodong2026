{
  "name": "@activity/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "migration:show": "npm run build && typeorm -d dist/data-source.js migration:show",
    "migration:run": "npm run build && typeorm -d dist/data-source.js migration:run",
    "migration:revert": "npm run build && typeorm -d dist/data-source.js migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/data-source.ts migration:generate src/migrations/AutoMigration",
    "test": "vitest run",
    "acceptance:member-points": "node ../../scripts/member-point-governance-acceptance.mjs",
    "acceptance:volunteer-governance": "node ../../scripts/volunteer-governance-acceptance.mjs",
    "preflight:volunteer-credentials": "node ../../scripts/preflight-volunteer-credentials-guard.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "brace-expansion": "5.0.8",
    "dotenv": "16.4.5",
    "exceljs": "^4.4.0",
    "glob": "13.0.6",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tencentcloud-sdk-nodejs": "^4.1.260",
    "typeorm": "0.3.31",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "chokidar": "^4.0.3",
    "miniprogram-ci": "^2.1.31",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1",
      "archiver": "8.0.0",
      "unzipper": "0.12.3"
    },
    "typeorm": {
      "glob": "$glob"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "$brace-expansion"
    },
    "tencentcloud-sdk-nodejs": {
      "uuid": "11.1.1"
    }
  }
}
