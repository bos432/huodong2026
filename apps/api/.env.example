NODE_ENV=development
API_PORT=3000

# Docker Compose mysql defaults use 127.0.0.1:3306 from the host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=activity
DB_PASSWORD=activitypass
DB_DATABASE=activity_registration

JWT_SECRET=dev-secret-change-me
CHECKIN_SIGNING_SECRET=dev-checkin-secret-change-me
CHECKIN_REVOKE_MINUTES=120
CHECKIN_OFFLINE_HOURS=8
CHECKIN_OFFLINE_MAX_ROWS=5000
MEMBER_LIFECYCLE_WORKER_ENABLED=true
MEMBER_BEHAVIOR_TAG_WORKER_ENABLED=true
MEMBER_BEHAVIOR_TAG_WORKER_INTERVAL_SECONDS=3600
MEMBER_LIFECYCLE_WORKER_INTERVAL_SECONDS=3600
MALL_MERCHANT_GOVERNANCE_WORKER_INTERVAL_MINUTES=60
MALL_INVENTORY_GOVERNANCE_WORKER_INTERVAL_MINUTES=15
MALL_ORDER_QUOTE_EXPIRE_MINUTES=10
MALL_ORDER_QUOTE_SECRET=replace-with-a-long-random-secret
MALL_PROMOTION_RATE_WINDOW_SECONDS=60
MALL_PROMOTION_RATE_USER_LIMIT=6
MALL_PROMOTION_RATE_DEVICE_LIMIT=10
MALL_PROMOTION_RATE_IP_LIMIT=20
MALL_PROMOTION_RISK_HASH_SECRET=replace-with-an-independent-random-secret
MALL_COUPON_CLAIM_RATE_WINDOW_SECONDS=60
MALL_COUPON_CLAIM_RATE_USER_LIMIT=10
MALL_COUPON_CLAIM_RATE_DEVICE_LIMIT=20
MALL_COUPON_CLAIM_RATE_IP_LIMIT=60
MALL_COUPON_IDENTITY_WINDOW_HOURS=24
MALL_COUPON_DEVICE_ACCOUNT_LIMIT=3
MALL_COUPON_IP_ACCOUNT_LIMIT=12
MALL_PROMOTION_ATTRIBUTION_WINDOW_HOURS=24
MALL_PROMOTION_DEVICE_BUYER_LIMIT=3
MALL_PROMOTION_IP_BUYER_REVIEW_LIMIT=10
MALL_PENDING_PAYMENT_EXPIRE_MINUTES=30
MALL_PENDING_CONFIRM_EXPIRE_MINUTES=1440
MALL_PENDING_ORDER_WORKER_INTERVAL_MINUTES=5
MALL_PENDING_ORDER_BATCH_SIZE=50
MALL_PENDING_ORDER_MAX_BATCHES=20
# disabled | sandbox | provider. Provider mode posts { company, trackingNo, shipmentNo } to the configured URL.
MALL_LOGISTICS_TRACKING_MODE=sandbox
MALL_LOGISTICS_TRACKING_API_URL=
MALL_LOGISTICS_TRACKING_API_TOKEN=
MALL_LOGISTICS_TRACKING_TIMEOUT_MS=10000
MALL_LOGISTICS_SANDBOX_AUTO_DELIVER=false
CONFIG_ENCRYPTION_KEY=change-me-config-encryption-key-32chars
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_PUBLIC_BASE_URL=
PRIVATE_CREDENTIAL_DIR=private-data/payment-credentials
AID_LOOKUP_HASH_SECRET=change-me-independent-aid-lookup-secret
ECOSYSTEM_LOOKUP_HASH_SECRET=change-me-independent-ecosystem-lookup-secret
VOLUNTEER_LOOKUP_HASH_SECRET=change-me-independent-volunteer-lookup-secret
VOLUNTEER_ATTENDANCE_SECRET=change-me-independent-volunteer-attendance-secret
PRIVATE_DOCUMENT_DIR=private-data/aid-documents
PRIVATE_ASSET_SIGNING_SECRET=replace-with-a-dedicated-random-secret
UPLOAD_MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Sandbox payment signatures for local WeChat/Alipay callback verification.
# Real merchant credentials and official provider signature verification are configured later.
PAYMENT_SANDBOX_SECRET=dev-payment-secret
WECHAT_PAY_SANDBOX_SECRET=
ALIPAY_PAY_SANDBOX_SECRET=

# Notification providers. Local development uses mock providers by default.
SMS_PROVIDER_ENABLED=mock
SMS_PROVIDER=mock-sms
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
EMAIL_PROVIDER_ENABLED=mock
EMAIL_PROVIDER=mock-email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WECHAT_MESSAGE_PROVIDER_ENABLED=mock
WECHAT_MESSAGE_PROVIDER=mock-wechat
WECHAT_MESSAGE_TEMPLATE_ID=
WECHAT_MESSAGE_TITLE_KEY=thing1
WECHAT_MESSAGE_CONTENT_KEY=thing2
WECHAT_MESSAGE_PAGE=pages/index/index
WECHAT_MESSAGE_MINIPROGRAM_STATE=formal
WECHAT_MESSAGE_MOCK_ALLOWED=true
EMAIL_PROVIDER_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
NOTIFICATION_FORCE_FAIL=false
NOTIFICATION_SCHEDULE_WORKER_ENABLED=false
NOTIFICATION_SCHEDULE_WORKER_INTERVAL_SECONDS=300
BUSINESS_JOB_WORKER_ENABLED=false
BUSINESS_JOB_WORKER_INTERVAL_SECONDS=30
BUSINESS_JOB_WORKER_ID=
ACTIVITY_LIFECYCLE_WORKER_ENABLED=false
ACTIVITY_LIFECYCLE_WORKER_INTERVAL_SECONDS=60
